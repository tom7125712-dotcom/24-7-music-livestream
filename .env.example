# RTMP destination. YouTube example:
# RTMP_URL=rtmp://a.rtmp.youtube.com/live2
RTMP_URL=

# Keep this private. Do not commit your real stream key.
STREAM_KEY=

# Optional: use this instead of RTMP_URL + STREAM_KEY.
# FULL_RTMP_URL=rtmp://example.com/app/key
FULL_RTMP_URL=

IMAGE_FILE=assets/background.png
AUDIO_FILE=assets/music.mp3

WIDTH=1920
HEIGHT=1080
FPS=30
VIDEO_BITRATE=3500k
AUDIO_BITRATE=192k
RESTART_DELAY=10

